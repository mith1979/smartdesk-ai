# Purpose: Configuration template for a new SmartDesk installation.
# Copy to .env and fill required values locally; never commit real secrets.
# Existing NUC users can retain their working shared FDE .env instead.
# Blank project values can mask populated shared FDE values.

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
GITHUB_TOKEN=
GITHUB_REPOSITORY=mith1979/smartdesk-tickets

# Optional: authenticate dataset downloads.
# HF_TOKEN=
